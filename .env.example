# Copy to .env (git-ignored) and fill in. Variables already set in the shell win.
# Only `ouroworld-reference-video` (paper §3.1) calls paid APIs; every other
# step runs locally.

# GPT motion prompt: OpenAI Responses API.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
OPENAI_BASE_URL=

# Seedance 2.0 video generation: BytePlus ModelArk.
ARK_API_KEY=

# Optional: Hugging Face token for gated weights (VGGT-Omega) in tools/download_weights.py.
HF_TOKEN=
